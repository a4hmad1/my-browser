{
  "name": "cinestream-browser",
  "productName": "CineStream Browser",
  "desktopName": "cinestream.desktop",
  "version": "1.2.0",
  "description": "Private desktop web browser with tabs, search, bookmarks, and ad and popup protection.",
  "homepage": "https://github.com/cinestream/movie-browser",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start-desktop.js",
    "start:browser": "node scripts/start-desktop.js",
    "install:desktop": "node scripts/install-desktop.js",
    "open:website": "node scripts/open-website.js",
    "build:linux": "node scripts/validate-release-config.js && electron-builder --linux AppImage deb",
    "build:win": "node scripts/validate-release-config.js && node scripts/build-windows-installer.js",
    "dist": "node scripts/validate-release-config.js && electron-builder",
    "serve:website": "node scripts/serve-website.js",
    "configure:desktop": "node scripts/configure-desktop.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check:sources": "node scripts/check-sources.js",
    "build:preview": "node scripts/build-preview.js",
    "build:preview:win": "node scripts/build-preview.js win",
    "serve:telegram": "cd backend && php artisan cinema:telegram-poll"
  },
  "keywords": [
    "web-browser",
    "private-browser",
    "adblocker",
    "popup-killer",
    "electron"
  ],
  "author": "CineStream Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cinestream.browser",
    "productName": "CineStream Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "cinestream@local"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CineStream Browser",
      "artifactName": "CineStream-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "artifactName": "CineStream-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "CineStream-${version}-win-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "cross-fetch": "^4.1.0"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
